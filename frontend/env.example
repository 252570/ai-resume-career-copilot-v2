# Local FastAPI API base URL. Copy to a private .env.local file for browser development.
# The managed preview hosts the frontend only; resume uploads require this local API configuration.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Production builds inject their own public API base URL through the managed build command.
# Do not replace the local value above with production configuration.
