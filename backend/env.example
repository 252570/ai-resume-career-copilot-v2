# Copy to a private `.env` file for local development. Do not commit real credentials.
APP_NAME=AI Resume & Career Copilot API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_ECHO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL only — replace placeholders locally or inject the value through deployment secrets.
DATABASE_URL=postgresql+psycopg://career_copilot:replace_with_local_password@localhost:5432/career_copilot

# Required for authentication. Must be at least 32 characters; the API refuses to issue
# tokens otherwise. Generate a unique value per environment and never reuse or commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_locally_generated_secret_of_32_plus_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
